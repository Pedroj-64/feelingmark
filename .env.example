# Copia a .env y rellena. NUNCA subas .env / Copy to .env, never commit it.
PORT=8787
# Token que usará la app para conectarse (se genera aleatorio si se deja vacío)
AUTH_TOKEN=
# Disco local o extraíble donde se guardan las fotos
STORAGE_DRIVER=local
STORAGE_PATH=./data/photos
DATABASE_PATH=./data/feelingmark.sqlite

# Alternativa: almacenamiento S3-compatible (Cloudflare R2, Backblaze B2, MinIO...)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=feelingmark
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Alternativa experimental: Google Drive (ver docs/google-drive.md)
# STORAGE_DRIVER=gdrive
# GOOGLE_CREDENTIALS_FILE=/ruta/client_secret.json   # el JSON que descarga Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_BASE=http://localhost:8787
