{
  // Despliegue en Cloudflare: Worker + D1 + R2 + cliente web. Ver docs/cloudflare.md
  "name": "feelingmark",
  "main": "src/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../mobile/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/photos", "/photos/*", "/days/*", "/albums", "/albums/*", "/memories", "/search", "/timeline", "/stats", "/collections", "/collections/*", "/i/*", "/d/*", "/shares/*", "/s/*", "/v/*"]
  },
  // D1 y R2 se crean solos en el primer `wrangler deploy` (aprovisionamiento automático).
  "d1_databases": [{ "binding": "DB", "database_name": "feelingmark" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "feelingmark-photos" }]
}
