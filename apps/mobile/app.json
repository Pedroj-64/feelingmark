{
  "expo": {
    "name": "Feelingmark",
    "slug": "feelingmark",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.feelingmark.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C4573A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.feelingmark.app",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withReleaseSigning",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Feelingmark lee tus fotos y videos solo para subir los que elijas a tu servidor. / Feelingmark reads your photos and videos only to upload the ones you choose to your server.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Feelingmark usa la cámara solo para leer el QR de tu servidor. / Feelingmark uses the camera only to read your server's QR.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "feelingmark"
  }
}
